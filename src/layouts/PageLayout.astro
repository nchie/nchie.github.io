---
import Base from "./Base.astro";

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<Base>
  <section class="page">
    <div class="container narrow">
      <h1 class="page-title">{title}</h1>
      <div class="page-body">
        <slot />
      </div>
    </div>
  </section>
</Base>
