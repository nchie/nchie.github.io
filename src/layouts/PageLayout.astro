---
import Base from "./Base.astro";

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<Base title={title}>
  <section class="py-10 md:py-14">
    <div class="mx-auto flex max-w-4xl flex-col gap-6 px-4">
      <h1 class="text-4xl font-semibold text-base-content md:text-5xl">
        {title}
      </h1>
      <div class="space-y-4 text-lg leading-8 text-base-content/85">
        <slot />
      </div>
    </div>
  </section>
</Base>
