---
import "../styles/global.css";
import { site } from "../config/site";

const pathname = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;700&family=Source+Serif+4:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href="/">{site.title}</a>
        <nav class="nav">
          <a href="/" class={pathname === "/" ? "active" : ""}>About</a>
          <a href="/blog/" class={pathname.startsWith("/blog") ? "active" : ""}>Blog</a>
        </nav>
      </div>
    </header>

    <main class="site-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>{site.title}</strong>
          <p class="small">{site.description}</p>
        </div>
        <div class="footer-links">
          <a href={`mailto:${site.email}`}>Email</a>
          <a href={site.github} target="_blank" rel="noopener">GitHub</a>
          <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </footer>

  </body>
</html>
