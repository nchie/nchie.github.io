---
import "../styles/tailwind.css";
import { site } from "../config/site";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  canonical?: string;
};

const { title, description, image, type = "website", canonical } = Astro.props as Props;
const pathname = Astro.url.pathname;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const pageDescription = description || site.description;
const canonicalUrl = canonical || Astro.url.href;
---

<!DOCTYPE html>
<html lang="en" data-theme="blog">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta name="twitter:image" content={image} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;700&family=Source+Serif+4:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-base-200 font-sans text-base-content antialiased">
    <div class="flex min-h-screen flex-col">
      <header class="sticky top-0 z-20 border-b border-base-300 bg-base-100/90 backdrop-blur">
        <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-4 py-3">
          <a class="text-lg font-semibold tracking-tight text-primary" href="/">
            {site.title}
          </a>
          <nav class="flex items-center gap-2 text-sm font-semibold">
            <a
              href="/"
              class={`btn btn-ghost btn-sm ${pathname === "/" ? "btn-active text-primary" : "text-base-content/80"}`}
              aria-current={pathname === "/" ? "page" : undefined}
            >
              About
            </a>
            <a
              href="/blog/"
              class={`btn btn-ghost btn-sm ${pathname.startsWith("/blog") ? "btn-active text-primary" : "text-base-content/80"}`}
              aria-current={pathname.startsWith("/blog") ? "page" : undefined}
            >
              Blog
            </a>
          </nav>
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="mt-10 border-t border-base-300 bg-base-100/80">
        <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-6">
          <div>
            <p class="text-lg font-semibold">{site.title}</p>
            <p class="text-sm text-base-content/70">{site.description}</p>
          </div>
          <div class="flex flex-wrap items-center gap-3 text-sm">
            <a class="link link-primary" href={`mailto:${site.email}`}>Email</a>
            <a class="link link-primary" href={site.github} target="_blank" rel="noopener">GitHub</a>
            <a class="link link-primary" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
