---
import LightboxImageComponent from "./LightboxImage.tsx";

type LightboxImageProps = {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  modalWidths?: number[];
  priority?: boolean;
  zoomable?: boolean;
  zoomLevel?: number;
};

const props = Astro.props as LightboxImageProps;
---

<LightboxImageComponent client:idle {...props} />
