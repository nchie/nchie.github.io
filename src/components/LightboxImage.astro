---
import LightboxImageComponent from "./LightboxImage.tsx";
import { getImage } from "astro:assets";
import { Picture } from "astro:assets";

export type LightboxImageProps = {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  modalWidths?: number[];
  priority?: boolean;
  zoomable?: boolean;
  zoomLevel?: number;
};

const {
  src,
  alt,
  caption,
  widths,
  modalWidths,
  priority = false,
  zoomable = true,
  zoomLevel = 2,
} = Astro.props as LightboxImageProps;

const previewWidths = widths ?? [640, 960, 1280, 1600];
const maxModalWidth = modalWidths && modalWidths.length > 0 ? Math.max(...modalWidths) : src.width;
const targetWidth = Math.min(4096, Math.max(src.width, Math.ceil(maxModalWidth * zoomLevel)));
const fullImage = await getImage({
  src,
  width: targetWidth,
  format: src.format,
});

const props = {
  src,
  alt,
  caption,
  widths,
  modalWidths,
  priority,
  zoomable,
  zoomLevel,
  fullSrc: fullImage.src,
  fullWidth: fullImage.attributes.width,
  fullHeight: fullImage.attributes.height,
};
---

<LightboxImageComponent client:idle {...props}>
  <div
    class="block w-full cursor-zoom-in rounded-xl border border-base-300 shadow-md transition overflow-hidden [&>picture>img]:object-contain [&>picture>img]:w-full [&>picture>img]:h-full [&>picture>img]:select-none"
  >
    <Picture
      src={src}
      alt={alt}
      widths={previewWidths}
      loading={priority ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={priority ? "high" : "auto"}
      pictureAttributes={{ class: "block w-full h-full" }}
    />
  </div>
</LightboxImageComponent>
