---
import LightboxImageComponent from "./LightboxImage.tsx";

export type LightboxImageProps = {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  modalWidths?: number[];
  priority?: boolean;
  zoomable?: boolean;
  zoomLevel?: number;
};

const {
  src,
  alt,
  caption,
  widths,
  modalWidths,
  priority = false,
  zoomable = true,
  zoomLevel = 2,
} = Astro.props as LightboxImageProps;

const props = {
  src,
  alt,
  caption,
  widths,
  modalWidths,
  priority,
  zoomable,
  zoomLevel,
};
---

<LightboxImageComponent client:idle {...props} />
