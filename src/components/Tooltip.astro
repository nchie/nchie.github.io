---
import TooltipFloating from "./TooltipFloating";

type TooltipProps = {
  text: string;
  position?: "top" | "bottom" | "left" | "right";
  tone?:
    | "primary"
    | "secondary"
    | "accent"
    | "info"
    | "success"
    | "warning"
    | "error"
    | "neutral";
};

const props = Astro.props as TooltipProps;
---

<TooltipFloating client:visible {...props}>
  <slot />
</TooltipFloating>
